{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "env": { "ENABLE_LSP_TOOL": "1" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CONFIG_DIR\"/hooks/ban-dangerous-commands.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/ynkt/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
